# --- Local development against the standalone Express server (server/index.js) ---
MONGODB_URI=mongodb://127.0.0.1:27017/invoice_manager
PORT=5000
# Point the frontend at that local Express server:
VITE_API_URL=http://localhost:5000/api

# Vercel Blob token, used for parcel photo uploads (both locally and on
# Vercel). Get this from Vercel -> Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN=

# --- On Vercel ---
# Set MONGODB_URI as a Vercel project env var (Settings -> Environment Variables).
# BLOB_READ_WRITE_TOKEN is added automatically once you create a Blob store
# under the project's Storage tab — you don't need to set it by hand there.
# Leave VITE_API_URL unset in production — the frontend defaults to "/api",
# which hits the serverless functions in the /api folder on the same domain.
